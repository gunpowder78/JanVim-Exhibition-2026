      "atMs": 22000,
      "target": "main",
      "kind": "editor-action",
      "payload": {
        "action": {
          "type": "insert",
          "text": "噪声不是错误的别名，它是传递条件的一部分，必须被测量而不是被责骂。\n若同一输入可能抵达多个输出，条件分布 P(Y|X) 就像水势绘成的航路图。\n发送者不能命令每滴水，只能选择一组足够分离的信号，让接收者仍可判断。\nchannel capacity 描述可靠传递能够逼近的最高速率，却不许我们凭愿望越界。\n",
          "charsPerSecond": 145
        },
        "displayKeys": [
          "i",
          "segment 02"
        ],
        "semanticLabel": "write frozen paper segment 02",
        "critical": true
      }
    },
